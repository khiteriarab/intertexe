# Email (Resend + Loops)
RESEND_API_KEY=
LOOPS_API_KEY=
# Founder Welcome is Loops-only. Set after you publish the Loops transactional
# with From: Khiteri <khiteri@intertexe.com>. Leave ENABLED unset until internal test passes.
# LOOPS_FOUNDER_WELCOME_TRANSACTIONAL_ID=
# LOOPS_FOUNDER_WELCOME_ENABLED=1
WEEKLY_EDIT_PREVIEW_EMAIL=
CRON_SECRET=
# Resend webhook signing secret (whsec_…) from Resend dashboard → Webhooks
RESEND_WEBHOOK_SECRET=
HQ_WEEKLY_REPORT_EMAIL=info@intertexe.com

# Resend From (verified domain mail.intertexe.com only — do not use root @intertexe.com on Resend):
#   Intertexe <info@mail.intertexe.com>
# Founder Welcome From is configured in Loops template UI:
#   Khiteri <khiteri@intertexe.com>
# Resend Reply-To for automated mail: info@intertexe.com

# Meta Pixel (browser) — Dataset ID from Events Manager
# NEXT_PUBLIC_META_PIXEL_ID=1853785949331787
# Optional later: META_CAPI_ACCESS_TOKEN=… (Conversions API — do not enable until CAPI wired)

# Executive AI (Dashboard conversational chat)
OPENAI_API_KEY=
# HQ_AI_MODEL=gpt-4o-mini

# Rakuten revenue — Reporting Platform API (preferred for verified commissions)
# In Publisher Center: Reports → open/create a transaction report → Get API → paste full URL:
# RAKUTEN_REPORTS_URL=https://ran-reporting.rakutenmarketing.com/en/reports/YOUR-KEY/filters?token=...&date_type=transaction
# Or discrete:
# RAKUTEN_REPORTS_TOKEN=
# RAKUTEN_REPORTS_KEY=
# RAKUTEN_REPORTS_LOOKBACK_DAYS=30
# RAKUTEN_REPORTS_DATE_TYPE=transaction

# Rakuten catalog FTP (product feeds — usually no transaction CSVs)
# RAKUTEN_FTP_HOST=aftp.linksynergy.com
# RAKUTEN_FTP_USERNAME=
# RAKUTEN_FTP_PASSWORD=
# RAKUTEN_REVENUE_FTP_DIR=/

# App Store (homepage + /khiteri download banners)
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6770476520
# Custom URL scheme registered on the iOS app (enables Open App when installed):
# NEXT_PUBLIC_APP_URL_SCHEME=intertexe
# Set to 1 only after the App Store build with Universal Links / intertexe:// is public:
# NEXT_PUBLIC_APP_DEEP_LINK_READY=1

# HQ OAuth security
# Required for encrypted token storage in hq_oauth_connections
HQ_TOKEN_ENCRYPTION_KEY=

# Supabase Management API (migrations via scripts/apply-sql-via-mgmt-api.mjs)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=burrylupizvggupsryuj

# Catalog taxonomy category picker (web Shop hub)
# NEXT_PUBLIC_CATALOG_TAXONOMY_NAV=1
# CATALOG_TAXONOMY_NAV=1

# TikTok Login Kit (production only)
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
# Optional override — user.info.stats is always included for follower count
# TIKTOK_OAUTH_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
