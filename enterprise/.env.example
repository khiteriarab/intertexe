# Copy to a local untracked file. Never commit real keys.

# Consumer / Founder HQ (existing)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enterprise / obelisk-core (required for DPP SaaS)
ENTERPRISE_SUPABASE_URL=
ENTERPRISE_SUPABASE_ANON_KEY=
ENTERPRISE_SUPABASE_SERVICE_ROLE_KEY=

# Optional. Dedicated HMAC secret for enterprise SSO state cookies.
# ENTERPRISE_SSO_STATE_SECRET=

# ── Paddle Billing (server-side only — never NEXT_PUBLIC_) ──
# PADDLE_API_KEY=                         # Sandbox or production API key
# PADDLE_WEBHOOK_SECRET=                  # Webhook signature secret from Paddle dashboard
# PADDLE_ENV=sandbox                      # sandbox | production (alias: PADDLE_ENVIRONMENT)
# PADDLE_GRACE_PERIOD_DAYS=14             # Days before restricted state after past_due

# Price IDs — map to internal plans (run: npx tsx scripts/sync-paddle-catalog.ts)
# PADDLE_PRICE_PLATFORM=pri_...
# PADDLE_PRICE_PROFESSIONAL=pri_...
# PADDLE_PRICE_IMPLEMENTATION=pri_...
# Legacy aliases still supported:
# PADDLE_PRICE_SAAS_PLATFORM / PADDLE_PRICE_SAAS_STARTER → platform
# PADDLE_PRICE_SAAS_PROFESSIONAL / PADDLE_PRICE_SAAS_GROWTH → professional
# PADDLE_PRICE_FOUNDING_PILOT → implementation (one-time)
# PADDLE_PRICE_PLAN_MAP_JSON={"pri_custom":{"plan":"enterprise","productAllowance":50000,"passportAllowance":25000,"kind":"subscription"}}

# Paddle.js client token — ONLY if using Paddle.js checkout overlay (optional)
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Supabase management API (local ops only — store in .env.enterprise.local, never commit)
# SUPABASE_ACCESS_TOKEN=
# ENTERPRISE_SUPABASE_PROJECT_REF=dpiksashuqetyzrjogal

# Optional. If set, staff handoff tokens can be signed as short-lived user JWTs.
# ENTERPRISE_SUPABASE_JWT_SECRET=

# Set true only against a disposable staging database
ENTERPRISE_ALLOW_LIVE_TESTS=false

# local | staging | production
ENTERPRISE_DEPLOYMENT_ENV=local
