# Copy to a local untracked file. Never commit real keys.

# Consumer / Founder HQ (existing)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enterprise / obelisk-core (required for DPP SaaS)
ENTERPRISE_SUPABASE_URL=
ENTERPRISE_SUPABASE_ANON_KEY=
ENTERPRISE_SUPABASE_SERVICE_ROLE_KEY=

# Optional. Dedicated HMAC secret for enterprise SSO state cookies.
# ENTERPRISE_SSO_STATE_SECRET=

# Paddle Billing (Phase C — B2B org subscriptions)
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_PRICE_FOUNDING_PILOT=pri_...
# PADDLE_PRICE_SAAS_STARTER=pri_...
# PADDLE_PRICE_SAAS_GROWTH=pri_...
# PADDLE_PRICE_PLAN_MAP_JSON={"pri_custom":{"plan":"saas","productAllowance":5000,"passportAllowance":1000}}

# Supabase management API (local ops only — store in .env.enterprise.local, never commit)
# SUPABASE_ACCESS_TOKEN=
# ENTERPRISE_SUPABASE_PROJECT_REF=dpiksashuqetyzrjogal

# Optional. If set, staff handoff tokens can be signed as short-lived user JWTs.
# Phase 1 mints a real GoTrue user session instead (no email is sent).
# ENTERPRISE_SUPABASE_JWT_SECRET=

# Set true only against a disposable staging database
ENTERPRISE_ALLOW_LIVE_TESTS=false

# local | staging | production
ENTERPRISE_DEPLOYMENT_ENV=local

# Preview may not point at production customer data unless explicitly allowed
# ENTERPRISE_ALLOW_PRODUCTION_DATA=false
